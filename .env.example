# Chave da API da TypeSafe (console.typesafe.ai/keys). Só no servidor, nunca no navegador.
TYPESAFE_API_KEY=
# Opcional: outro endereço para a API, só HTTPS da TypeSafe ou um Jev falso local nos testes.
TYPESAFE_API_URL=
# Opcional: avaliações por minuto para cada cliente (padrão 10). Os testes ponta a ponta sobem.
AUDIENCE_RATE_LIMIT=
# Endereço público do site, para os links e as imagens dos cartões.
SITE_URL=https://aplausometro.rafaelcamillo.com.br
